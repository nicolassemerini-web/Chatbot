# Copia este archivo como ".env.local" y rellena los valores.
# ".env.local" NUNCA se sube a git. No pegues claves reales en ningún chat.
#
# Regla de oro: solo las variables que empiezan por NEXT_PUBLIC_ llegan al
# navegador. Ninguna clave privada debe llevar ese prefijo.

# --- Aplicación ---------------------------------------------------------
# URL pública del sitio (en local, localhost; en producción, tu dominio).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------
# En supabase.com, dentro de tu proyecto:
#   - URL: botón "Connect" o Project Settings > Data API > Project URL.
#   - Claves: Project Settings > API Keys.
# Sin estas variables la web funciona en modo demostración (sin cuentas ni chat).

# Pública: puede llegar al navegador; los datos los protegen las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (empieza por sb_publishable_). También vale la antigua "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PRIVADA, solo servidor. "Secret key" (empieza por sb_secret_); también vale la
# antigua "service_role key". Salta las políticas RLS: la usa únicamente el
# servidor para guardar mensajes y conversaciones del usuario ya verificado.
SUPABASE_SECRET_KEY=

# --- Proveedor de IA (solo servidor) ------------------------------------
# Proveedor activo: "mock" o "anthropic".
#   mock      respuestas simuladas (sin clave ni coste): sirve para desarrollar.
#   anthropic Claude de verdad. Necesita ANTHROPIC_API_KEY.
AI_PROVIDER=mock

# Modelo de las respuestas. Con "anthropic", si se deja vacío se usa Claude
# Haiku 5.5. Un personaje puede tener su propio modelo (columna "model").
AI_CHAT_MODEL=claude-haiku-5-5

# Clave de Anthropic (console.anthropic.com > API Keys). PRIVADA: solo aquí.
ANTHROPIC_API_KEY=

# --- Límites de consumo -------------------------------------------------
# Mensajes por día: dependen del plan del usuario (tabla "plans", columna
# daily_messages; el plan gratuito trae 30). Desde la Fase 3 se editan en el panel.
# Peticiones de chat por usuario y minuto (protección anti-abuso).
LIMIT_CHAT_REQUESTS_PER_MINUTE=10
# Freno de emergencia: si el gasto estimado de HOY (de todos los usuarios) llega
# a este tope, en céntimos de dólar, la IA se pausa hasta mañana. 500 = 5 $.
LIMIT_GLOBAL_AI_DAILY_BUDGET_CENTS=500
# Precios en dólares por millón de tokens, para estimar el gasto. Los valores
# por defecto son los de Claude Haiku 5.5. Si cambias de modelo, cámbialos.
# AI_PRICE_INPUT_PER_MTOK_USD=0.10
# AI_PRICE_OUTPUT_PER_MTOK_USD=0.50

# --- Conservación de datos -----------------------------------------------
# Días que se conservan los mensajes en bruto. Los recuerdos y resúmenes
# siguen su propia caducidad. Ver docs/architecture.md, sección de privacidad.
RETENTION_MESSAGES_DAYS=180

# --- Pagos (Fase 6, todavía NO se usa) ----------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
