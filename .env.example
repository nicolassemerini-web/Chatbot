# Copia este archivo como ".env.local" y rellena los valores.
# ".env.local" NUNCA se sube a git. No pegues claves reales en ningún chat.
#
# Regla de oro: solo las variables que empiezan por NEXT_PUBLIC_ llegan al
# navegador. Ninguna clave privada debe llevar ese prefijo.

# --- Aplicación ---------------------------------------------------------
# URL pública del sitio (en local, localhost; en producción, tu dominio).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ----------------------------------
# Públicas: protegidas por las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# PRIVADA, solo servidor. Salta las políticas RLS: úsala únicamente en tareas
# administrativas concretas (borrado de cuenta, trabajos programados).
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de IA (solo servidor) ------------------------------------
# Proveedor activo. Valores previstos: "anthropic" | "mock".
# "mock" responde con textos fijos y permite desarrollar sin clave ni coste.
AI_PROVIDER=mock

# Modelo para las respuestas de los personajes y modelo económico para tareas
# internas (extracción de recuerdos, resúmenes). Ver docs/costs-and-services.md.
AI_CHAT_MODEL=claude-sonnet-5-5
AI_UTILITY_MODEL=claude-haiku-5-5

# Clave del proveedor (console.anthropic.com > API Keys). PRIVADA.
ANTHROPIC_API_KEY=

# --- Límites de consumo (valores por defecto, ajustables) ----------------
# Mensajes por usuario y día en el plan gratuito.
LIMIT_FREE_MESSAGES_PER_DAY=30
# Longitud máxima de un mensaje de usuario, en caracteres.
LIMIT_MAX_MESSAGE_CHARS=2000
# Peticiones de chat por usuario y minuto (protección anti-abuso).
LIMIT_CHAT_REQUESTS_PER_MINUTE=10
# Tope global de gasto diario en IA, en céntimos de euro (freno de emergencia).
LIMIT_GLOBAL_AI_DAILY_BUDGET_CENTS=500

# --- Conservación de datos -----------------------------------------------
# Días que se conservan los mensajes en bruto. Los recuerdos y resúmenes
# siguen su propia caducidad. Ver docs/architecture.md, sección de privacidad.
RETENTION_MESSAGES_DAYS=180

# --- Pagos (Fase 5, todavía NO se usa) ----------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
